{
 "framework": null,
 "buildCommand": "",
 "outputDirectory": "public",
 "rewrites": [
  {
   "source": "/api/:path*",
   "destination": "/api/router?__p=:path*"
  }
 ],
 "functions": {
  "api/router.js": {
   "maxDuration": 60,
   "includeFiles": "{public/farm/demo.json,data/reference.json}"
  }
 },
 "crons": [
  {
   "path": "/api/cron/daily",
   "schedule": "0 11 * * *"
  }
 ],
 "cleanUrls": true
}